# ==============================================================================
# POSHPRINT LUXURY APPAREL — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and replace the values with your production credentials.
# NEVER commit real secrets or credentials to public Git repositories.
# ==============================================================================

# Application Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Payment Gateway Configuration (Stripe Sandbox / Production)
# Obtain test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Administrative Console Authentication
ADMIN_USER=atelier_admin
ADMIN_SECRET_KEY=your_secure_random_admin_token_here

# Optional Database & Storage Backends (PostgreSQL / Supabase / Redis)
DATABASE_URL=postgresql://poshuser:poshpassword@localhost:5432/poshprint_db?sslmode=require
REDIS_URL=redis://localhost:6379

# Transactional Email / Courier Dispatch Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="POSHPRINT Concierge <concierge@poshprint.luxury>"
